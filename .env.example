# Microsoft Entra ID (Azure AD) Configuration
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
SESSION_SECRET=
# Optional session lifetime. Idle timeout renews on every request; the cap bounds
# one Microsoft sign-in however active it stays. Defaults: 60 minutes, 5 hours.
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=5

# Gemini API key (server-only; never sent to the browser)
GEMINI_API_KEY=
# Browser-side Gemini key for local development parsing only. Never set in hosted deployments.
BROWSER_GEMINI_API_KEY=

# App Configuration
APP_URL=http://localhost:3000

# Milliseconds before the Graph proxy aborts an upstream request. Large OneNote
# section page listings regularly exceed 30s; the abort surfaced as a section
# that failed to load. Default 90000.
GRAPH_PROXY_TIMEOUT_MS=90000

# Collaboration pilot. Leave disabled for the current single-user localhost app.
# In a hosted pilot, owner and lead accounts receive all configured classes.
# Other tenant accounts are interns only when they belong to one or more of the
# configured Microsoft 365 class groups.
COLLABORATION_PILOT_ENABLED=false
COLLABORATION_OWNER_UPNS=teacher@university.example
COLLABORATION_LEAD_UPNS=lead@university.example
COLLABORATION_CLASS_IDS=class-group-id-1,class-group-id-2,class-group-id-3,class-group-id-4
